{
  "name": "@mezgeb/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/sync-shared.mjs --check && vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "font:subset": "node scripts/subset-font.mjs",
    "icons": "node scripts/make-icons.mjs",
    "sync:shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "idb": "8.0.4",
    "preact": "^10.29.8",
    "react-router": "7.18.4",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^8.0.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "subset-font": "2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  }
}
